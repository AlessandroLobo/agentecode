{
  "name": "agentecode-core",
  "displayName": "AgenteCode Core",
  "description": "Recursos próprios do AgenteCode: histórico de sessões do agente, volta de arquivos (checkpoint), exportação para Markdown e notas de versão.",
  "version": "1.0.1",
  "publisher": "agentecode",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentecode.exportSessionToMarkdown",
    "onCommand:agentecode.undoLastRewind",
    "onCommand:agentecode.showReleaseNotes",
    "onView:agentecode.sessions"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agentecode.exportSessionToMarkdown",
        "title": "Exportar sessão do agente para Markdown",
        "category": "AgenteCode",
        "icon": "$(export)"
      },
      {
        "command": "agentecode.undoLastRewind",
        "title": "Desfazer a última volta de arquivos",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sessions.refresh",
        "title": "Atualizar sessões",
        "category": "AgenteCode",
        "icon": "$(refresh)"
      },
      {
        "command": "agentecode.sessions.search",
        "title": "Buscar nas sessões do agente",
        "category": "AgenteCode",
        "icon": "$(search)"
      },
      {
        "command": "agentecode.sessions.clearSearch",
        "title": "Limpar busca de sessões",
        "category": "AgenteCode",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentecode.sessions.resume",
        "title": "Retomar sessão no Claude Code",
        "category": "AgenteCode",
        "icon": "$(play)"
      },
      {
        "command": "agentecode.sessions.delete",
        "title": "Excluir sessão (Lixeira)",
        "category": "AgenteCode",
        "icon": "$(trash)"
      },
      {
        "command": "agentecode.sessions.rewind",
        "title": "Voltar arquivos para antes desta resposta",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.showReleaseNotes",
        "title": "Mostrar notas da versão",
        "category": "AgenteCode"
      }
    ],
    "configuration": {
      "title": "AgenteCode",
      "properties": {
        "agentecode.export.includeToolResults": {
          "type": "boolean",
          "default": true,
          "description": "Inclui, de forma resumida, a saída das ferramentas (comandos, leitura de arquivos) na exportação da sessão para Markdown."
        },
        "agentecode.export.maxToolResultChars": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "Tamanho máximo, em caracteres, de cada saída de ferramenta incluída na exportação."
        },
        "agentecode.sessions.resumeLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "enumDescriptions": [
            "No Claude Code do painel lateral direito (integrado).",
            "Em uma nova aba do editor."
          ],
          "description": "Onde o botão Retomar do painel de sessões abre a conversa."
        },
        "agentecode.releaseNotes.show": {
          "type": "boolean",
          "default": true,
          "description": "Abre as novidades na primeira vez que o AgenteCode inicia depois de uma atualização."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentecode-sessions",
          "title": "Sessões do agente",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentecode-sessions": [
        {
          "id": "agentecode.sessions",
          "name": "Histórico de sessões",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentecode.sessions",
        "contents": "Nenhuma sessão do agente encontrada para esta pasta.\nAbra o Claude Code (Ctrl+L) e converse para criar a primeira."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentecode.sessions.resume",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "agentecode.sessions.searching"
        }
      ],
      "view/title": [
        {
          "command": "agentecode.sessions.search",
          "when": "view == agentecode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "view == agentecode.sessions && agentecode.sessions.searching",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.sessions.refresh",
          "when": "view == agentecode.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@3"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "9_danger@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "inline@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "1_actions@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentecode.sessions.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == agentecode.sessions"
      }
    ],
    "configurationDefaults": {
      "claudeCode.preferredLocation": "sidebar"
    }
  }
}
